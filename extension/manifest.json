{
  "manifest_version": 3,
  "name": "Family Watch Party \u2013 LiveBarn helper",
  "short_name": "FWP helper",
  "version": "0.2.0",
  "description": "Downloads your kids' games from your own LiveBarn account when you ask, straight into your Family Watch Party Drive folder.",
  "key": "",
  "permissions": [
    "downloads",
    "identity",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://watch.livebarn.com/*",
    "https://livebarn-prod-vod-media.s3.amazonaws.com/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://watch.livebarn.com/*"
      ],
      "js": [
        "lib/plan.js",
        "livebarn.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://scalisec.github.io/*"
    ]
  },
  "minimum_chrome_version": "116"
}

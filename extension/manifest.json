{
  "manifest_version": 3,
  "name": "Family Watch Party – LiveBarn helper",
  "short_name": "FWP helper",
  "version": "0.1.0",
  "description": "Downloads your kids' games from your own LiveBarn account when you ask, for Family Watch Party.",
  "key": "",
  "permissions": ["downloads"],
  "host_permissions": ["https://watch.livebarn.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://watch.livebarn.com/*"],
      "js": ["lib/plan.js", "livebarn.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": ["https://scalisec.github.io/*"]
  },
  "minimum_chrome_version": "116"
}
